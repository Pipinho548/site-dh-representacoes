# Redirecionamentos dos endereços antigos (WordPress) para o site novo
# Mantém o Google e links salvos funcionando.
Redirect 301 /glass-house/ /representadas/glass-house.html
Redirect 301 /alumiconte/ /representadas/alumiconte.html
Redirect 301 /bragagnolo/ /representadas/bragagnolo.html
Redirect 301 /alcaplas/ /representadas/alcaplas.html
Redirect 301 /hd-ferragens/ /representadas/hd-ferragens.html
Redirect 301 /puxe/ /representadas/puxe.html
Redirect 301 /formato/ /representadas/formato.html
Redirect 301 /alpa/ /representadas/alpa.html
Redirect 301 /plastiben/ /representadas/plastiben.html
Redirect 301 /ageplast/ /representadas/ageplast.html
Redirect 301 /iluminium/ /representadas/iluminium.html
Redirect 301 /mmn/ /representadas/mmn.html
Redirect 301 /benpor/ /representadas/benpor.html
Redirect 301 /sannypack/ /representadas/sannypack.html
Redirect 301 /politicas-de-privacidade/ /politica-de-privacidade.html
Redirect 301 /sample-page/ /

ErrorDocument 404 /404.html

# https e domínio sem www
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://dhrepresentacoes.com.br%{REQUEST_URI} [L,R=301]
</IfModule>

# Compressão
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/xml
</IfModule>

# Cache: imagens 1 ano, CSS/JS 1 semana, HTML sempre atualizado
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType text/css "access plus 1 week"
ExpiresByType application/javascript "access plus 1 week"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>
